{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/hostplus-snapshot.schema.json",
  "title": "Hostplus Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "source", "holdings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "string",
      "enum": ["hostplus-confirmed", "manual", "imported"]
    },
    "totalBalance": { "type": "number", "minimum": 0 },
    "notes": { "type": "string" },
    "holdings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionKey", "label", "units", "unitPrice"],
        "properties": {
          "optionKey": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "units": { "type": "number", "minimum": 0 },
          "unitPrice": { "type": "number", "minimum": 0 },
          "balance": { "type": "number", "minimum": 0 },
          "balanceWeight": { "type": "number", "minimum": 0, "maximum": 1 },
          "futureTransactionWeight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
