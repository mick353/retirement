{
  "name": "robinson-retirement",
  "displayName": "Robinson Retirement Command Centre",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build:engine": "node tools/build-retirement-engine.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.pages.json",
    "validate:model": "npm run build:engine && node tools/validate-retirement-model.mjs",
    "validate:visuals": "node --check public/atlas.js && node tools/validate-atlas-visuals.mjs",
    "validate:mobile": "node tools/validate-mobile-layout.mjs",
    "build": "npm run build:pages",
    "build:pages": "npm run validate:model && npm run validate:visuals && npm run validate:mobile && vite build --config vite.pages.config.ts",
    "preview": "vite preview --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "type": "module"
}
